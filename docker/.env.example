# 复制成 .env 再填。.env 已被 .gitignore 忽略。
#
# ⚠️ 不要把 control-plane API key 写在这里 —— 那会进容器的环境变量。
#    key 放 secrets/control-plane.key，compose 用 file: 引用挂进容器。

# 隧道 ID（必填）。平台：platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_00000000000000000000000000000000

# 镜像版本。升级就是改这里再 docker compose up -d --build
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.14

# 健康检查端口（宿主侧）。8080 已被 cdj-local-deploy-public-api-1 占用。
HEALTH_PORT=18080

# 日志：struct-text 给人看，json 给机器看
LOG_LEVEL=info
LOG_FORMAT=struct-text

# ============================================================================
# MCP 目标 —— 两种模式二选一
# ============================================================================
#
# 【模式 A】容器内 stdio（默认）：run_command 执行容器内 shell
MCP_COMMAND=node /app/server.js
MCP_SERVER_URL=
#
# 想换成容器内的 DesktopCommander（工具从 5 个变 25 个）就改上面那行：
#   MCP_COMMAND=npx -y @wonderwhy-er/desktop-commander@latest
#
# ----------------------------------------------------------------------------
# 【模式 B】Windows 宿主上的 HTTP MCP server：run_powershell 执行真实 Windows 命令
#
# 按下面两行改。MCP_COMMAND 必须留空 —— 两个都指向 main channel 会报
# `mcp config: duplicate channel "main"`。
#
#   MCP_COMMAND=
#   MCP_SERVER_URL=http://host.docker.internal:18090/t/<你的 MCP_PATH_TOKEN>/mcp
#
# 这个 token 是你自己定的：Windows 侧启动 server 时用 MCP_PATH_TOKEN=<同一个值>。
# 因为那个 server 监听双栈（LAN 可达），路径里的密钥就是那道门。
#
# ----------------------------------------------------------------------------
# 【模式 C】自建中继 relay（26 工具，走 device 进程）—— 推荐
#
#   MCP_COMMAND=
#   MCP_SERVER_URL=<见下面两种形态>
#
# 这个模式有两种形态，只差 MCP_SERVER_URL 一个变量：
#
#   C-1 服务器形态：relay 和 tunnel 作为同一个单元部署（relay 是主服务，
#       tunnel 是它的边车）。用 compose 服务名直连，**不走宿主**：
#
#         MCP_COMMAND=
#         MCP_SERVER_URL=http://relay:18086/mcp
#         # 启动要带 profile：
#         #   docker compose --profile server up -d
#
#   C-2 本机开发形态：relay 直接跑在宿主上（cd ../relay && node src/index.js），
#       这里只起隧道。relay 服务被 profile 挡住，不会来抢宿主的 18086。
#
#         MCP_COMMAND=
#         MCP_SERVER_URL=http://host.docker.internal:18086/mcp
#
# 下面用 C-1（relay 进容器 + 隧道当边车）作为默认 —— 这也是**当前实际运行形态**，
# 2026-09-18 16:35 从 C-2 切过来。启动必须带 profile：
#
#   docker compose --profile server up -d
#
# 想退回"中继跑在宿主上"的开发形态：把值换成 C-2 那行，去掉 --profile server。
MCP_COMMAND=
MCP_SERVER_URL=http://relay:18086/mcp
# ----------------------------------------------------------------------------

# ============================================================================
# 出站静态头 —— 给 MCP server 加静态凭据的唯一受支持位置
# ============================================================================
#
# ⚠️ 别去 ChatGPT connector 的「身份验证」下拉里找 API key —— 那里只有
#    OAuth / 无身份验证 / 混合 三档，**没有 API key**。静态凭据的设计位置
#    就是这里（tunnel-client 的 mcp.extra-headers），由 tunnel-client 在
#    「它 → MCP server」最后一跳注入，官方文档明确它不经过 OpenAI 控制面。
#
# 接自建中继（模式 3）时，中继按 `Authorization: Bearer rmcp_…` 解析租户，
# 所以在这里注入那枚令牌：
#
#   MCP_EXTRA_HEADERS=Authorization: file:/run/secrets/relay_mcp_token
#
# 令牌文件由 `node relay/tools/mint-tunnel-token.js` 生成（内容必须是完整
# 头值 `Bearer rmcp_<prefix>_<secret>` —— file: 是整值匹配，写
# `Bearer file:/path` 会被当字面量）。
#
# ⚠️ 两个前提：
#   1. ChatGPT connector 的身份验证要选「无身份验证」。选 OAuth / 混合时，
#      connector 转发来的 Authorization 会**覆盖**这个静态值（后应用者胜）。
#   2. 值里不能出现 `,` 或 `;` —— 环境变量形式按这两个字符切分成多个头。
#
# 留空 = 不注入任何头。
MCP_EXTRA_HEADERS=

# 挂进容器的宿主路径（左：宿主，右：容器内 /host/*）。只在模式 A 下有用。
HOST_WORKSPACE=/mnt/c/Users/longyuan/workspace
HOST_HOME=/root

# 想指向自建控制面时取消注释
# CONTROL_PLANE_BASE_URL=https://api.openai.com

# ============================================================================
# relay —— 只在「服务器形态」（C-1）下需要
# ============================================================================
#
#   docker compose --profile server up -d
#
# 这些变量在 C-2（本机开发）下全部被忽略：那种形态的中继直接读 relay/.env。
#
# ⚠️ compose 里这些用的是 `${VAR-default}` 而**不是** `${VAR:?}`。
#    因为 compose 的 `:?` 插值对**所有**服务生效、不认 profile —— 用 `:?` 会把
#    本机开发形态也一起弄得起不来。所以"必须有值"由中继自己判：ANON_KEY /
#    SERVICE_ROLE_KEY 缺失时它拒绝启动并列出具体缺哪一项。

# 中继自己访问 Supabase 的地址。
#   与 Supabase 同机 → http://host.docker.internal:8000
#   用托管实例      → https://<ref>.supabase.co
SUPABASE_URL=http://host.docker.internal:8000

# 下发给 device 的地址。device 在别的机器上，所以**必须**是 device 能访问到的
# URL（通常是公网域名）。允许与上面不同 —— 中继走内网、device 走公网是常见形态。
# 填错的症状：device 拿不到 Supabase 配置，一直连不上。
PUBLIC_SUPABASE_URL=http://127.0.0.1:8000

# 中继的对外地址。device flow 的授权链接与 OAuth 发现端点靠它拼绝对地址。
#   本机自用 → http://127.0.0.1:18086
#              **必须显式写**：容器内 RELAY_HOST=0.0.0.0，不写会拼出
#              http://0.0.0.0:18086，device 那边打不开这个链接。
#   上公网   → https://mcp.example.com
RELAY_PUBLIC_URL=http://127.0.0.1:18086

# 本机是明文 http，cookie 带 Secure 属性浏览器就不会回传 → 控制台登不进去。
# **上 HTTPS 后必须改成 true。**
RELAY_COOKIE_SECURE=false

# 安全姿态 —— compose 已给这些默认值，列出来是为了让你知道可以覆盖。
# 注意这里**没有** RELAY_REQUIRE_AUTH —— 那个开关 2026-09-18 已删除，
# /mcp 无条件要求令牌（OAuth 签发的，或控制台人工创建的）。
# RELAY_ALLOW_SIGNUP=false     # 源码默认是 true（开放注册），服务器上务必显式关掉
# RELAY_TRUST_PROXY=true       # 前面有 TLS 反代才是 true；否则 XFF 可伪造，限速形同虚设
# RELAY_ROUTE_POLICY=auto-single  # 单台自动路由 / 多台必须显式指定 device_id
# RELAY_OWNER_EMAIL=device@remote-mcp.local   # 遗留单租户账号，只在引导首个管理员时用到

# OAuth 2.1 授权服务器。它的对外地址就是 RELAY_PUBLIC_URL —— 没有单独的
# 配置项，因为授权页、token 端点、发现文档必须同源，分开配迟早配歪。
#   ⚠️ 部署门槛：授权页要能被**终端用户自己的浏览器**打开。
#      走隧道的场景下这不成立（OpenAI 明确：授权服务器不通过隧道传输），
#      所以上了公网域名之后才能把 connector 的「身份验证」改成 OAuth。

# 服务器形态还需要这三个 secret 文件（均为单行；结尾换行会被 trim 掉）：
#   secrets/relay-admin-token.txt          printf '%s\n' "$(openssl rand -hex 32)"
#   secrets/supabase-anon-key.txt          与 Supabase 的 ANON_KEY 同值
#   secrets/supabase-service-role-key.txt  与 Supabase 的 SERVICE_ROLE_KEY 同值
# 中继通过 `<KEY>_FILE` 读它们，值不经过环境变量，因此不出现在 docker inspect 的明文里。
