# 复制成 .env 再填。.env 已被 .gitignore 忽略。
#
# ⚠️ 不要把 control-plane API key 写在这里 —— 那会进容器的环境变量。
#    key 放 secrets/control-plane.key，compose 用 file: 引用挂进容器。

# 隧道 ID（必填）。平台：platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_00000000000000000000000000000000

# 镜像版本。升级就是改这里再 docker compose up -d --build
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.14

# 健康检查端口（宿主侧）。8080 已被 cdj-local-deploy-public-api-1 占用。
HEALTH_PORT=18080

# 日志：struct-text 给人看，json 给机器看
LOG_LEVEL=info
LOG_FORMAT=struct-text

# ============================================================================
# MCP 目标 —— 两种模式二选一
# ============================================================================
#
# 【模式 A】容器内 stdio（默认）：run_command 执行容器内 shell
MCP_COMMAND=node /app/server.js
MCP_SERVER_URL=
#
# 想换成容器内的 DesktopCommander（工具从 5 个变 25 个）就改上面那行：
#   MCP_COMMAND=npx -y @wonderwhy-er/desktop-commander@latest
#
# ----------------------------------------------------------------------------
# 【模式 B】Windows 宿主上的 HTTP MCP server：run_powershell 执行真实 Windows 命令
#
# 按下面两行改。MCP_COMMAND 必须留空 —— 两个都指向 main channel 会报
# `mcp config: duplicate channel "main"`。
#
#   MCP_COMMAND=
#   MCP_SERVER_URL=http://host.docker.internal:18090/t/<你的 MCP_PATH_TOKEN>/mcp
#
# 这个 token 是你自己定的：Windows 侧启动 server 时用 MCP_PATH_TOKEN=<同一个值>。
# 它替代了"自定义请求头"——tunnel-client 没法给 MCP server 发自定义头，
# 而 server 监听双栈（LAN 可达），所以用路径里的密钥当那道门。
#
# 例：
#   MCP_COMMAND=
#   MCP_SERVER_URL=http://host.docker.internal:18090/t/9f3c1a7b2e5d4086/mcp
# ----------------------------------------------------------------------------

# 挂进容器的宿主路径（左：宿主，右：容器内 /host/*）。只在模式 A 下有用。
HOST_WORKSPACE=/mnt/c/Users/longyuan/workspace
HOST_HOME=/root

# 想指向自建控制面时取消注释
# CONTROL_PLANE_BASE_URL=https://api.openai.com
