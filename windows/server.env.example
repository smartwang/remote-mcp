# Windows MCP server 的本地配置。复制成 server.env 后改。
# server.env 已被 .gitignore 忽略。
#
# 这个 token 是本地共享密钥：容器经 host.docker.internal 连进来时，
# 端点必须带它。改这里之后，docker/.env 里的 MCP_SERVER_URL 要同步改。
MCP_PATH_TOKEN=replace-with-your-own-random-token

# 监听端口。docker/.env 的 MCP_SERVER_URL 要对应。
MCP_PORT=18090

# 监听地址。默认 ::（双栈）。绑 127.0.0.1 的话容器连不进来。
MCP_BIND=::

# 传输：http（给隧道用）| stdio（给本机 MCP 客户端用）
MCP_TRANSPORT=http

# 单次工具返回的字符上限
MCP_MAX_CHARS=20000

# 可选：文件工具白名单，分号分隔。不设=不限制。
# MCP_ALLOWED_ROOTS=C:\Users\longyuan\workspace;D:\projects

# 可选：要求 Authorization: Bearer <值>。默认不启用。
# MCP_BEARER=

# 可选：覆盖 PowerShell 路径
# MCP_POWERSHELL=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
