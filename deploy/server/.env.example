# deploy/server/.env —— 复制成 .env 后填。**这个文件不要入库**（.env 已在 .gitignore 里）。
#
# 三个必填项下面标了「必填」。compose 对没填的必填项会直接报错退出，
# 不会带着一个猜出来的默认值悄悄跑起来 —— 那种"猜错但看起来正常"最难查。

# ---------------------------------------------------------------------------
# 必填 ①：对外地址
# ---------------------------------------------------------------------------
# 终端用户浏览器直接打开的地址，也是 AS issuer、PRM resource、device 验证链接
# 的共同来源。**结尾不要带斜杠。**
# 必须是 https —— 浏览器和 ChatGPT 都要求；用 http 会让授权页直接失败。
RELAY_PUBLIC_URL=https://mcp.example.com

# ---------------------------------------------------------------------------
# 必填 ②③：Supabase
# ---------------------------------------------------------------------------
# 中继自己访问用。托管实例就填项目地址。
SUPABASE_URL=
# 下发给 device 的地址。device 在别的机器上，所以必须是它也访问得到的地址。
# 用托管实例时通常和上面同值。
PUBLIC_SUPABASE_URL=

# 对应的两个密钥不写在这里，写进 secrets/ 下的文件（见 README）。

# ---------------------------------------------------------------------------
# 安全姿态（compose 已给默认值，列出来是为了让你知道可以覆盖）
# ---------------------------------------------------------------------------
# 没有 RELAY_REQUIRE_AUTH —— 那个开关 2026-09-18 已删除，/mcp 无条件要求令牌。
#
# 注册开关。false = 只有管理员能开账号。**上公网保持 false**：
# 开放注册意味着任何人注册一个账号后就能把**自己的**机器接进这套系统，
# 而设备授权要人工批准 —— 但账号本身会占库、占 UI 位。
RELAY_ALLOW_SIGNUP=false

# 单台在线设备自动选；多台则拒绝执行并列出候选（名字/id/最后心跳）。
# 换成 auto-any 会变成"自动选最近心跳的那台" —— 少一次确认，多一次写错机器的机会。
RELAY_ROUTE_POLICY=auto-single

# 遗留单租户账号。多租户下只在一处用到：引导第一个管理员账号。
RELAY_OWNER_EMAIL=device@remote-mcp.local
# 引导第一个管理员账号时用到。**必须改掉默认值** —— 默认口令是公开的。
RELAY_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------
# 留空则用 compose 里的默认值 ghcr.io/smartwang/remote-mcp-relay:latest。
# 生产建议钉到具体摘要，避免 latest 被下一次构建顶掉：
#   RELAY_IMAGE=ghcr.io/smartwang/remote-mcp-relay@sha256:<digest>
RELAY_IMAGE=

# ---------------------------------------------------------------------------
# 限速（滑动窗口，按客户端 IP）
# ---------------------------------------------------------------------------
# user_code 暴力猜解的后果特别严重 —— 猜中就能批准那台设备，受害者的机器
# 会被绑到攻击者账号上。所以批准接口单独一条更严的限速。
RELAY_RL_APPROVE_MAX=10
RELAY_RL_APPROVE_WINDOW_MS=300000
RELAY_RL_LOGIN_MAX=20
RELAY_RL_LOGIN_WINDOW_MS=300000
RELAY_RL_MCP_AUTH_MAX=60
RELAY_RL_MCP_AUTH_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# 缓存与超时
# ---------------------------------------------------------------------------
# 同进程内吊销立即生效（revoke 会清缓存）；这个 TTL 只约束多副本部署时的
# 跨进程传播延迟。当前是单副本，改大只是省数据库查询。
TOKEN_CACHE_TTL_MS=30000
TOKEN_TOUCH_INTERVAL_MS=60000

# 单次工具调用的等待上限。device 侧契约写明服务端超时是 5 分钟，保持一致。
CALL_TIMEOUT_MS=300000
CALL_POLL_INTERVAL_MS=400

# 设备"新鲜"窗口。必须明显大于具备广播能力的设备的心跳间隔（5 分钟）。
DEVICE_FRESH_MS=900000

DEVICE_CODE_TTL_S=300
DEVICE_POLL_INTERVAL_S=2

# 生产必须 false。置 true 等价于"任何能访问 /device/start 的人都能拿到设备权限"。
DEVICE_FLOW_AUTO_APPROVE=false
