# relay/.env —— 复制成 .env 后按需修改。
#
# ⚠️ ANON_KEY / SERVICE_ROLE_KEY 不用写在这里：中继会自动去
#    ../supabase/selfhosted/.env 读。这样只有一份真源，不会出现
#    "两处密钥悄悄不一致"。
#
# 这里只放中继自己的配置。

# 中继监听地址。
# 已占用的端口：8080（CDJ public-api）、18080（tunnel 健康端口/UI）、
# 18090（windows MCP server）、8787（com.docker.backend 的端口转发器）。
RELAY_PORT=18086
RELAY_HOST=127.0.0.1

# 中继访问 Supabase 的地址。
#   同机（Supabase 跑在 Docker Desktop）：http://127.0.0.1:8000
#   中继也进了同一个 compose 网络：      http://supabase-envoy:8000
SUPABASE_URL=http://127.0.0.1:8000

# 下发给 device 的 Supabase 地址。device 在别的机器上时，这里必须是
# 那台机器能访问到的地址（公网阶段就是 https://你的域名）。
# 留空 = 与 SUPABASE_URL 相同。
PUBLIC_SUPABASE_URL=

# 中继对外的地址，用于拼 device flow 的验证链接。
RELAY_PUBLIC_URL=

# ---- device flow ----
# 单租户阶段：批准时建立/复用的账号
RELAY_OWNER_EMAIL=device@remote-mcp.local
RELAY_OWNER_PASSWORD=remote-mcp-device-owner

# 本地联调开关：true 时 /device/start 直接置为已批准，不用点浏览器。
# 生产必须为 false —— 它等价于"任何能访问 /device/start 的人都能拿到设备权限"。
DEVICE_FLOW_AUTO_APPROVE=false

DEVICE_CODE_TTL_S=300
DEVICE_POLL_INTERVAL_S=2

# ---- 调用 ----
# 对齐 device 侧契约：remote-channel.ts 注释里写明服务端超时是 5 分钟
CALL_TIMEOUT_MS=300000
CALL_POLL_INTERVAL_MS=400

# 设备"新鲜"窗口。必须明显大于具备广播能力的设备的心跳间隔（5 分钟）。
DEVICE_FRESH_MS=900000

# ---- 其他 ----
CATALOG_PATH=

# 可选：给 /mcp 加一条路径令牌（放 URL 里，因为 ChatGPT 侧不一定能控制
# Authorization 头）。留空则不加。公网部署前建议设置。
MCP_PATH_TOKEN=
