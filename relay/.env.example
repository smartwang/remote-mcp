# relay/.env —— 复制成 .env 后按需修改。
#
# ⚠️ ANON_KEY / SERVICE_ROLE_KEY 不用写在这里：中继会自动去
#    ../supabase/selfhosted/.env 读。这样只有一份真源，不会出现
#    "两处密钥悄悄不一致"。
#
# 这里只放中继自己的配置。

# 中继监听地址。
# 已占用的端口：8080（CDJ public-api）、18080（tunnel 健康端口/UI）、
# 18090（windows MCP server）、8787（com.docker.backend 的端口转发器）。
RELAY_PORT=18086
RELAY_HOST=127.0.0.1

# 中继访问 Supabase 的地址。
#   同机（Supabase 跑在 Docker Desktop）：http://127.0.0.1:8000
#   中继也进了同一个 compose 网络：      http://supabase-envoy:8000
SUPABASE_URL=http://127.0.0.1:8000

# 下发给 device 的 Supabase 地址。device 在别的机器上时，这里必须是
# 那台机器能访问到的地址（公网阶段就是 https://你的域名）。
# 留空 = 与 SUPABASE_URL 相同。
PUBLIC_SUPABASE_URL=

# 中继对外的地址，用于拼 device flow 的验证链接。
RELAY_PUBLIC_URL=

# =============================================================================
# 多租户鉴权
# =============================================================================
#
# 三套身份，走不同的路由，互不复用：
#   1. AI 客户端 → /mcp           Authorization: Bearer rmcp_<prefix>_<secret>
#   2. 人（浏览器）→ /console /device  Cookie: rmcp_session=...（HMAC 签名）
#   3. 管理员 → /admin             HTTP Basic 或 Bearer <RELAY_ADMIN_TOKEN>
#
# 令牌在控制台（/console → 我的访问令牌）创建，明文只显示一次，库里只存
# sha256(secret)。前缀明文存库，仅用于"一句话定位到行"。

# ---- 这里曾经有个 RELAY_REQUIRE_AUTH 开关，2026-09-18 已删除 ----
# 它的 false 档会让 /mcp **不校验令牌**，把请求匿名回落到一个遗留 owner 账号。
# 这在不同 ChatGPT 用户共用一条隧道时是有害的：无论谁来调，中继看到的都是
# 同一个人，租户隔离、审计、每租户设备全部失去输入，而且**不报任何错**。
#
# 现在没有开关了，/mcp 无条件要求有效令牌，唯一的身份来源是 Authorization 头：
#   · AI 客户端（ChatGPT 等）→ OAuth 2.1 授权码 + PKCE 签发
#   · 自建脚本 → /console「我的访问令牌」人工签发
# 没令牌 = 401 + WWW-Authenticate 质询（带上 PRM 地址，供客户端做 OAuth 发现）。
#
# ChatGPT connector 侧的配置见 relay/README.md「鉴权：OAuth 2.1」一节。

# ---- 管理员令牌 ----
# 持有者可看到**所有**租户的设备、用户与审计记录。留空 = 管理员面完全关闭。
# 生成：node -e "console.log('rmcpadmin_'+require('crypto').randomBytes(24).toString('base64url'))"
RELAY_ADMIN_TOKEN=

# ---- 浏览器会话 ----
# cookie 的 HMAC 签名密钥。留空则首次启动自动生成并写入 relay/.session-secret
# （该文件已在 .gitignore 里）。两种写法二选一，推荐留空走文件 ——
# 写在这里意味着每次手抄一遍密钥，容易在重启后把所有人踢下线。
RELAY_SESSION_SECRET=
RELAY_SESSION_SECRET_FILE=

# 会话有效期（秒），默认 7 天。
RELAY_SESSION_TTL_S=604800

# cookie 是否只走 HTTPS。本地 http 调试必须 false；**上公网必须 true**，
# 否则会话 cookie 会在明文 HTTP 上传输。
RELAY_COOKIE_SECURE=false
RELAY_COOKIE_NAME=rmcp_session

# ---- 令牌校验缓存 ----
# 同进程内吊销立即生效（revoke 会清缓存）；这个 TTL 只约束多副本部署
# 时的跨进程传播延迟。改大省数据库查询，改小让跨进程吊销更快生效。
TOKEN_CACHE_TTL_MS=30000
# 同一令牌的 last_used_at 最多多久写一次库（纯统计字段，不值得每次都写）。
TOKEN_TOUCH_INTERVAL_MS=60000

# ---- 设备路由策略 ----
# 一个租户有多台**在线**设备、而调用方没指定 device_id 时怎么办：
#   auto-single（默认）只有一台就自动选；多台则报错并列出候选
#   auto-any          自动选最近心跳的那台（旧的全局语义，现已收窄到租户内）
# 默认值防的是"以为是 A 机器、实际写了 B"这类误操作。
RELAY_ROUTE_POLICY=auto-single

# ---- 注册开关 ----
# true = 任何人可自助注册账号（并因此获得操作**其自有**设备的能力）。
# 自建内网友好；上公网前应评估是否关闭，或加邀请码/邮箱域名白名单。
RELAY_ALLOW_SIGNUP=true

# ---- 限速（滑动窗口，按客户端 IP）----
# user_code 暴力猜解的后果特别严重 —— 猜中就能批准那台设备，受害者的机器
# 会被绑到攻击者账号上。所以批准接口单独设一条更严的限速。
RELAY_RL_APPROVE_MAX=10
RELAY_RL_APPROVE_WINDOW_MS=300000
RELAY_RL_LOGIN_MAX=20
RELAY_RL_LOGIN_WINDOW_MS=300000
# 令牌校验失败也限速，防前缀存在性探测。
RELAY_RL_MCP_AUTH_MAX=60
RELAY_RL_MCP_AUTH_WINDOW_MS=60000

# ---- 客户端 IP 来源 ----
# 中继前面是隧道或反向代理，所以默认信任 X-Forwarded-For 第一跳。
# 若把中继端口**直接**暴露到公网，XFF 可被伪造 —— 后果仅限于限速被绕过
# （鉴权靠令牌，不靠 IP）。真要直连公网请置 false。
RELAY_TRUST_PROXY=true

# ---- device flow ----
# 单租户阶段的遗留账号。多租户下**只在一处用到**：引导第一个管理员账号。
# 它不再是所有设备的归属账号 —— 每个租户批准设备时建的是自己的账号。
RELAY_OWNER_EMAIL=device@remote-mcp.local
RELAY_OWNER_PASSWORD=remote-mcp-device-owner

# 本地联调开关：true 时 /device/start 直接置为已批准，不用点浏览器。
# 生产必须为 false —— 它等价于"任何能访问 /device/start 的人都能拿到设备权限"。
DEVICE_FLOW_AUTO_APPROVE=false

DEVICE_CODE_TTL_S=300
DEVICE_POLL_INTERVAL_S=2

# ---- 调用 ----
# 对齐 device 侧契约：remote-channel.ts 注释里写明服务端超时是 5 分钟
CALL_TIMEOUT_MS=300000
CALL_POLL_INTERVAL_MS=400

# 设备"新鲜"窗口。必须明显大于具备广播能力的设备的心跳间隔（5 分钟）。
DEVICE_FRESH_MS=900000

# ---- 其他 ----
CATALOG_PATH=

# 可选：给 /mcp 加一条路径令牌（放 URL 路径里）。留空则不加。
#
# ⚠️ 多租户下它**不是主路径**，别把它当鉴权手段：
#   · 隧道只会把 AI 客户端的 Authorization 头转发给 MCP 服务（实测确认），
#     不会转发请求路径 —— 隧道把请求固定打到一个配置好的 MCP 路径上；
#   · 所以路径令牌只在"直连中继、不经隧道"的场景有用，例如运维自测。
# 租户身份一律走 Bearer 令牌（见本文件顶部的多租户段）。
MCP_PATH_TOKEN=
